# Local server
APP_HOST=127.0.0.1
APP_PORT=8765
APP_ENV=development

# Trust mode
# Set STRICT_ANALYSIS_MODE=true when you want the analyzer to fail instead of silently using demo fallback.
STRICT_ANALYSIS_MODE=false
# Minimum overall evidence confidence required before a report can become actionable.
MIN_ACTIONABLE_CONFIDENCE=0.60

# V0.5 official filing evidence
# Enrich reports with NSE company-submitted filing metadata. Failures are surfaced, never guessed.
OFFICIAL_EVIDENCE_ENABLED=true
# Keep false during V0.5 rollout. Set true after official adapters/XBRL parsing are validated locally.
REQUIRE_OFFICIAL_EVIDENCE=false
OFFICIAL_EVIDENCE_CACHE_MINUTES=20

# Prospective validation. Benchmark is used for long-term excess returns.
# Cost percentage is an estimate; adjust it for your actual taxes, brokerage and slippage.
VALIDATION_BENCHMARK_SYMBOL=^NSEI
VALIDATION_ROUND_TRIP_COST_PCT=0.25
VALIDATION_UPDATE_LIMIT=100
# India market date used by the daily idempotency key. Keep this as Asia/Kolkata.
VALIDATION_TIMEZONE=Asia/Kolkata
# A running job older than this may be retried after a crash.
VALIDATION_RUN_TIMEOUT_MINUTES=120

# PostgreSQL (recommended). If blank, local SQLite fallback is used for first-run testing.
DATABASE_URL=postgresql+psycopg://stock_analyzer:CHANGE_ME@127.0.0.1:5432/stock_analyzer

# Data provider: auto | yfinance | demo
DATA_PROVIDER=auto
DEFAULT_SYMBOL=INFY.NS

# Zerodha - keep secrets only in your local .env, never commit them.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://127.0.0.1:8765/api/zerodha/callback

# Optional local watchlist used by the opportunity scanner
WATCHLIST=INFY.NS,TCS.NS,HCLTECH.NS,POWERGRID.NS,NTPC.NS,ITC.NS,HDFCBANK.NS,SBIN.NS,GAIL.NS,PETRONET.NS,PIIND.NS,NATCOPHARM.NS
